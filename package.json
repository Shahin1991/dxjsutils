{
  "name": "dxjsutils",
  "version": "1.0.0",
  "description": "dxjsutils - desktop productivity toolbox for Emirates employees",
  "author": "EK",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.6.0",
    "electron-is-dev": "^2.0.0",
    "js-yaml": "^5.4.3",
    "marked": "^12.0.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^29.4.0",
    "electron-builder": "^24.13.3",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "wait-on": "^7.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && npm run electron\"",
    "electron-build": "npm run build && electron-builder",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "env": {
      "es2020": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": "eslint --fix --max-warnings=0"
  },
  "build": {
    "appId": "com.dxjsutils.app",
    "productName": "dxjsutils",
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "public/Ek_logo.png",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "zip"
      ],
      "certificateFile": "${env.WIN_CSC_LINK}",
      "certificatePassword": "${env.WIN_CSC_KEY_PASSWORD}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
